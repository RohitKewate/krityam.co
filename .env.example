# Copy to .env.local for local testing, and add the same variables in Vercel → Project → Settings → Environment Variables.
# PostHog stays off when NEXT_PUBLIC_POSTHOG_KEY is empty.

# PostHog → Project settings → Project API key (starts with phc_). Safe to expose; it can only send events.
NEXT_PUBLIC_POSTHOG_KEY=

# "us" or "eu": the region you picked when creating the PostHog project.
NEXT_PUBLIC_POSTHOG_REGION=us
